{
  "name": "codex-podcast-workflow-migration",
  "version": "1.0.0",
  "created_at": "2026-09-10",
  "target": {
    "os": "macOS",
    "architecture": "arm64",
    "python": ">=3.10,<3.14",
    "verified_python": "3.12.14"
  },
  "defaults": {
    "workspace": "~/Documents/Codex podcast Product",
    "codex_home": "${CODEX_HOME:-~/.codex}",
    "skill": "refine-podcast-dialogue"
  },
  "security": {
    "contains_credentials": false,
    "contains_user_or_group_ids": false,
    "contains_history_or_audio": false,
    "feishu_is_optional": true
  },
  "runtime": {
    "python_package": "mlx-whisper==0.4.3",
    "system_commands": ["ffmpeg", "ffprobe"]
  },
  "validation": {
    "cold_install": "pass",
    "idempotent_install": "pass",
    "conflict_protection": "pass",
    "backup_before_force": "pass",
    "skill_structure": "pass",
    "transcript_checker": "pass",
    "dialogue_checker": "pass"
  }
}
